{
  "name": "mutex",
  "version": "1.2.2",
  "private": true,
  "description": "Advisory lock service for CI/CD pipelines. Prevents race conditions by ensuring mutual exclusion: only one job can access shared resources concurrently.",
  "main": "lib/main.js",
  "bin": {
    "mutex": "./bin/mutex.js"
  },
  "scripts": {
    "clean": "rm -rf lib dist",
    "lint": "prettier --ignore-unknown --write '**/*.{ts,js,json,md,yml,yaml}'",
    "build:watch": "tsc --watch",
    "build": "npm run clean && tsc && npm run package",
    "package": "ncc build lib/main.js -o dist/main && ncc build lib/post.js -o dist/post",
    "package:action": "npm run build && node scripts/package-action.mjs",
    "mutex": "node ./bin/mutex.js",
    "test": "npm run typecheck && NODE_OPTIONS=--experimental-vm-modules jest",
    "prepare": "husky",
    "typecheck": "tsc -p tsconfig.test.json"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@actions/core": "^3.0.0",
    "@actions/github": "^9.1.1",
    "@slack/web-api": "^8.0.0",
    "@types/pg": "^8.15.5",
    "pg": "^8.16.3",
    "pg-format": "^1.0.4"
  },
  "devDependencies": {
    "@swc/core": "^1.15.0",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/pg-format": "^1.0.5",
    "@vercel/ncc": "^0.45.0",
    "husky": "^9.1.7",
    "jest": "^30.0.0",
    "prettier": "^3.6.2",
    "typescript": "^7.0.0"
  },
  "type": "module"
}
